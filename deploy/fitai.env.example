FITAI_MODE=server
FITAI_PUBLIC_ORIGIN=https://fitai.example.com
FITAI_DATA_DIR=/var/lib/fitai
FITAI_PORT=8765
FITAI_TIMEOUT=90
FITAI_MAX_USERS=20
FITAI_USER_QUOTA_MB=512
# Only administrator-controlled, trusted HTTPS origins. No path, wildcard or trailing slash.
FITAI_MODEL_ORIGINS=https://api.deepseek.com,https://api.openai.com
PYTHONUNBUFFERED=1
TZ=Asia/Shanghai

# Optional site defaults (server only). Empty personal keys fall back to these.
# Keep real secrets only in a root-owned 600 EnvironmentFile, never in this example.
FITAI_SHARED_API_KEY=
FITAI_SHARED_BASE_URL=https://api.deepseek.com/v1
FITAI_SHARED_MODEL=deepseek-flash
FITAI_SHARED_TAVILY_API_KEY=
