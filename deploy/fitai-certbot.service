[Unit]
Description=Renew JianJianFei HTTPS certificates
After=network-online.target nginx.service
Wants=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/opt/fitai-certbot/bin/python3 /opt/fitai/deploy/certbot-network.py renew --quiet --no-random-sleep-on-renew --deploy-hook "/usr/sbin/nginx -t && /bin/systemctl reload nginx"
Restart=on-failure
RestartSec=5min
TimeoutStartSec=20min
